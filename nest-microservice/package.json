{
  "name": "nest-microservice",
  "version": "0.0.1",
  "description": "NestJS microservices monorepo: KrakenD API gateway + REST microservices + NATS events + Prisma/Postgres",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build deployment-service && nest build notification-service && nest build content-service && nest build ai-service && nest build nats-setup",
    "start:deployment": "nest start deployment-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:content": "nest start content-service --watch",
    "start:ai": "nest start ai-service --watch",
    "nats:setup": "nest start nats-setup",
    "start:dev": "npm run nats:setup && concurrently -k -n deployment,notification,content,ai -c green,magenta,cyan,yellow \"npm:start:deployment\" \"npm:start:notification\" \"npm:start:content\" \"npm:start:ai\"",
    "start:prod:deployment": "node dist/apps/deployment-service/main",
    "start:prod:notification": "node dist/apps/notification-service/main",
    "start:prod:content": "node dist/apps/content-service/main",
    "start:prod:ai": "node dist/apps/ai-service/main",
    "start:prod:nats-setup": "node dist/apps/nats-setup/main",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --config apps/deployment-service/prisma.config.ts && prisma generate --config apps/notification-service/prisma.config.ts && prisma generate --config apps/content-service/prisma.config.ts && prisma generate --config apps/ai-service/prisma.config.ts",
    "prisma:studio": "prisma studio --config apps/deployment-service/prisma.config.ts",
    "migration:dev": "prisma migrate dev --config apps/deployment-service/prisma.config.ts",
    "migration:create": "prisma migrate dev --create-only --config apps/deployment-service/prisma.config.ts",
    "migration:dev:notification": "prisma migrate dev --config apps/notification-service/prisma.config.ts",
    "migration:dev:content": "prisma migrate dev --config apps/content-service/prisma.config.ts",
    "migration:create:content": "prisma migrate dev --create-only --config apps/content-service/prisma.config.ts",
    "migration:dev:ai": "prisma migrate dev --config apps/ai-service/prisma.config.ts",
    "migration:create:ai": "prisma migrate dev --create-only --config apps/ai-service/prisma.config.ts",
    "migration:run": "prisma migrate deploy --config apps/deployment-service/prisma.config.ts && prisma migrate deploy --config apps/notification-service/prisma.config.ts && prisma migrate deploy --config apps/content-service/prisma.config.ts && prisma migrate deploy --config apps/ai-service/prisma.config.ts",
    "migration:status": "prisma migrate status --config apps/deployment-service/prisma.config.ts && prisma migrate status --config apps/notification-service/prisma.config.ts && prisma migrate status --config apps/content-service/prisma.config.ts && prisma migrate status --config apps/ai-service/prisma.config.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs}/**/*.ts\"",
    "seed:article-templates": "ts-node -r tsconfig-paths/register --project apps/content-service/tsconfig.app.json apps/content-service/scripts/seed-article-templates.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config apps/deployment-service/test/jest-integration.json --runInBand && jest --config apps/content-service/test/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@google/genai": "^3.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.9",
    "htmlparser2": "^12.0.0",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "nats": "^2.29.3",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "esModuleInterop": true
          },
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/**/src/**/*.ts",
      "libs/**/src/**/*.ts",
      "!**/main.ts",
      "!**/migrations/**",
      "!**/generated/**"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(htmlparser2|domhandler|domutils|dom-serializer|domelementtype|entities)/)"
    ]
  }
}
