// content-service database (ADR 0025, 0026): the sites' articles and their categories.
// Every business table carries site_id; every query filters on it (the service checks the
// caller's sites first). Articles and categories are deleted for real (no soft delete), so their
// slugs can be reused.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs" // the Nest apps compile to CommonJS
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A client site (nails, wine...). Its languages decide which translations an article needs.
model Site {
  id               String            @id(map: "pk_sites") @db.VarChar(50)
  name             String            @db.VarChar(100)
  locales          String[]          @db.VarChar(10)
  defaultLocale    String            @map("default_locale") @db.VarChar(10)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  categories       Category[]
  articles         Article[]
  media            Media[]
  brandKit         StudioBrandKit?
  avatars          StudioAvatar[]
  projects         StudioProject[]
  articleDraftJobs ArticleDraftJob[]

  @@map("sites")
}

model Category {
  id           String                @id(map: "pk_categories") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String                @map("site_id") @db.VarChar(50)
  site         Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_categories_site")
  key          String                @db.VarChar(50)
  position     Int                   @default(0)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations CategoryTranslation[]
  articles     Article[]
  draftJobs    ArticleDraftJob[]

  @@unique([siteId, key], map: "uq_categories_site_key")
  @@map("categories")
}

model CategoryTranslation {
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "fk_category_translations_category")
  siteId     String   @map("site_id") @db.VarChar(50)
  locale     String   @db.VarChar(10)
  name       String   @db.VarChar(80)
  slug       String   @db.VarChar(100)

  @@id([categoryId, locale], map: "pk_category_translations")
  @@unique([siteId, locale, slug], map: "uq_category_translations_site_locale_slug")
  @@map("category_translations")
}

model Article {
  id              String                @id(map: "pk_articles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String                @map("site_id") @db.VarChar(50)
  site            Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_articles_site")
  categoryId      String                @map("category_id") @db.Uuid
  category        Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_articles_category")
  /// draft | scheduled | published (ArticleStatus in libs/common)
  status          String                @default("draft") @db.VarChar(20)
  featured        Boolean               @default(false)
  /// Cover image (media library of the same site); a used image can't be deleted.
  coverMediaId    String?               @map("cover_media_id") @db.Uuid
  coverMedia      Media?                @relation(fields: [coverMediaId], references: [id], onDelete: Restrict, map: "fk_articles_cover_media")
  scheduledAt     DateTime?             @map("scheduled_at") @db.Timestamptz(6)
  publishedAt     DateTime?             @map("published_at") @db.Timestamptz(6)
  createdBy       String                @map("created_by") @db.VarChar(255)
  updatedBy       String                @map("updated_by") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations    ArticleTranslation[]
  redirects       ArticleSlugRedirect[]
  translationJobs TranslationJob[]
  aiDraftJobs     ArticleDraftJob[]

  @@index([siteId, status, publishedAt(sort: Desc)], map: "ix_articles_site_status_published")
  @@index([scheduledAt], map: "ix_articles_due", where: raw("(status)::text = 'scheduled'::text"))
  @@index([categoryId], map: "ix_articles_category_id")
  @@index([coverMediaId], map: "ix_articles_cover_media_id")
  @@map("articles")
}

/// One language of an article. The slug is per language (SEO) and unique per site + language.
model ArticleTranslation {
  articleId      String  @map("article_id") @db.Uuid
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "fk_article_translations_article")
  siteId         String  @map("site_id") @db.VarChar(50)
  locale         String  @db.VarChar(10)
  title          String  @db.VarChar(200)
  slug           String  @db.VarChar(150)
  excerpt        String  @db.VarChar(500)
  coverAlt       String? @map("cover_alt") @db.VarChar(300)
  /// HTML sanitized by the service (ADR 0031, ARTICLE_HTML_TAGS in libs/common)
  body           String
  readingMinutes Int     @map("reading_minutes")
  seoTitle       String? @map("seo_title") @db.VarChar(200)
  seoDescription String? @map("seo_description") @db.VarChar(300)

  @@id([articleId, locale], map: "pk_article_translations")
  @@unique([siteId, locale, slug], map: "uq_article_translations_site_locale_slug")
  @@map("article_translations")
}

/// An old slug of a live article: the site answers 301 to the current one (links and search
/// results keep working). Removed when another article takes the slug.
model ArticleSlugRedirect {
  siteId    String   @map("site_id") @db.VarChar(50)
  locale    String   @db.VarChar(10)
  slug      String   @db.VarChar(150)
  articleId String   @map("article_id") @db.Uuid
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "fk_article_slug_redirects_article")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([siteId, locale, slug], map: "pk_article_slug_redirects")
  @@index([articleId], map: "ix_article_slug_redirects_article_id")
  @@map("article_slug_redirects")
}

/// An image of a site's media library (ADR 0034), optimized by the admin's browser and uploaded
/// straight to the PUBLIC bucket in several sizes: media/<site_id>/<id>/<width>.<ext>.
/// pending until the service has checked every size in storage; pending rows older than a day
/// are deleted with their objects (MediaCleanupService).
model Media {
  id              String              @id(map: "pk_media") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String              @map("site_id") @db.VarChar(50)
  site            Site                @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_media_site")
  /// pending | ready | failed (an AI image that could not be made, ADR 0037)
  status          String              @default("pending") @db.VarChar(20)
  /// upload (the admin's browser, ADR 0034) | ai (ai-service, ADR 0037)
  source          String              @default("upload") @db.VarChar(20)
  /// source ai: the description it was generated from
  prompt          String?             @db.VarChar(1000)
  generationJobId String?             @map("generation_job_id") @db.Uuid
  generationJob   ImageGenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull, map: "fk_media_generation_job")
  /// status failed: why (provider_refused, provider_unavailable…)
  error           String?             @db.VarChar(50)
  filename        String              @db.VarChar(200)
  contentType     String              @map("content_type") @db.VarChar(50)
  /// The largest size
  width           Int
  height          Int
  /// Every size: [{ width, height, size }], widest last
  variants        Json
  createdBy       String              @map("created_by") @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedAt      DateTime?           @map("uploaded_at") @db.Timestamptz(6)
  covers          Article[]
  avatars         StudioAvatar[]
  brandLogos      StudioBrandKit[]

  @@index([siteId, status, createdAt(sort: Desc)], map: "ix_media_site_status_created")
  @@index([status, createdAt], map: "ix_media_pending", where: raw("(status)::text = 'pending'::text"))
  @@index([generationJobId], map: "ix_media_generation_job_id")
  @@map("media")
}

/// One request for AI images (ADR 0037): its `count` pending media rows are filled by ai-service.
/// Never deleted: the monthly quota per site sums these (an image deleted later still counted).
model ImageGenerationJob {
  id          String    @id(map: "pk_image_generation_jobs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId      String    @map("site_id") @db.VarChar(50)
  prompt      String    @db.VarChar(1000)
  aspectRatio String    @map("aspect_ratio") @db.VarChar(10)
  /// Images asked for
  count       Int
  /// pending | completed | failed
  status      String    @default("pending") @db.VarChar(20)
  /// Images actually made (known once answered): the quota counts these, else `count`
  generated   Int?
  provider    String?   @db.VarChar(30)
  model       String?   @db.VarChar(100)
  /// failed: a TranslationFailure-like reason
  error       String?   @db.VarChar(50)
  createdBy   String    @map("created_by") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  media       Media[]

  @@index([siteId, createdAt(sort: Desc)], map: "ix_image_generation_jobs_site_created")
  @@map("image_generation_jobs")
}

/// A machine translation of an article (ADR 0036): requested here (outbox), done by ai-service,
/// its result written back as a DRAFT translation by AiResultsConsumer.
model TranslationJob {
  id           String    @id(map: "pk_translation_jobs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String    @map("site_id") @db.VarChar(50)
  articleId    String    @map("article_id") @db.Uuid
  article      Article   @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "fk_translation_jobs_article")
  sourceLocale String    @map("source_locale") @db.VarChar(10)
  targetLocale String    @map("target_locale") @db.VarChar(10)
  /// Replace an existing translation of targetLocale (asked explicitly).
  overwrite    Boolean   @default(false)
  /// pending | completed | failed
  status       String    @default("pending") @db.VarChar(20)
  /// The source language as sent (fields + body): the answer is put back into exactly this.
  source       Json
  /// failed: a TranslationFailure or a local reason (article_not_draft, translation_exists…)
  error        String?   @db.VarChar(50)
  detail       String?   @db.VarChar(300)
  /// completed: [{ index, kind, text }] segments a reviewer should check (numbers, markup changed)
  warnings     Json?
  provider     String?   @db.VarChar(30)
  model        String?   @db.VarChar(100)
  createdBy    String    @map("created_by") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([articleId, createdAt(sort: Desc)], map: "ix_translation_jobs_article_created")
  @@map("translation_jobs")
}

/// Inbox (ADR 0007): ids of the events this service consumed (ai-service answers), written in
/// the SAME transaction as their effect.
/// Video studio (ADR 0039): the brand a site's clips use (one row per site).
model StudioBrandKit {
  siteId        String   @id(map: "pk_studio_brand_kits") @map("site_id") @db.VarChar(50)
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade, map: "fk_studio_brand_kits_site")
  brandName     String   @map("brand_name") @db.VarChar(100)
  tagline       String?  @db.VarChar(200)
  phone         String?  @db.VarChar(40)
  callToAction  String?  @map("call_to_action") @db.VarChar(200)
  tone          String?  @db.VarChar(300)
  footerNote    String?  @map("footer_note") @db.VarChar(200)
  /// The business facts the studio fills in by itself (typed once, never by AI): website, address
  /// lines, opening hours ("Days | Hours" lines), price list ("Service | Price" lines).
  website       String?  @db.VarChar(80)
  address       String?  @db.VarChar(200)
  hours         String?  @db.VarChar(300)
  prices        String?  @db.VarChar(400)
  bannedPhrases String[] @map("banned_phrases") @db.VarChar(100)
  primaryColor  String   @map("primary_color") @db.VarChar(7)
  accentColor   String   @map("accent_color") @db.VarChar(7)
  logoMediaId   String?  @map("logo_media_id") @db.Uuid
  logoMedia     Media?   @relation(fields: [logoMediaId], references: [id], onDelete: SetNull, map: "fk_studio_brand_kits_logo_media")
  updatedBy     String   @map("updated_by") @db.VarChar(255)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([logoMediaId], map: "ix_studio_brand_kits_logo_media_id")
  @@map("studio_brand_kits")
}

/// A host who appears in clips: a media-library photo, a default voice, and who agreed (consent).
model StudioAvatar {
  id          String   @id(map: "pk_studio_avatars") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId      String   @map("site_id") @db.VarChar(50)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_studio_avatars_site")
  name        String   @db.VarChar(80)
  mediaId     String   @map("media_id") @db.Uuid
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict, map: "fk_studio_avatars_media")
  voice       String   @db.VarChar(40)
  consentNote String   @map("consent_note") @db.VarChar(500)
  createdBy   String   @map("created_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([siteId, name], map: "ix_studio_avatars_site_name")
  @@index([mediaId], map: "ix_studio_avatars_media_id")
  @@map("studio_avatars")
}

/// One clip in the making: template + inputs → script (AI, edited) → voice → render.
model StudioProject {
  id              String         @id(map: "pk_studio_projects") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String         @map("site_id") @db.VarChar(50)
  site            Site           @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_studio_projects_site")
  templateId      String         @map("template_id") @db.VarChar(40)
  templateVersion Int            @map("template_version")
  title           String         @db.VarChar(120)
  language        String         @db.VarChar(10)
  status          String         @default("draft") @db.VarChar(20)
  brief           String?        @db.VarChar(1000)
  /// StudioInputs: slot id → media / avatar / voice id, fact id → text or article id.
  inputs          Json
  /// StudioScript, null until the AI (or the admin) wrote it.
  script          Json?
  warnings        Json           @default("[]")
  scriptJobId     String?        @map("script_job_id") @db.Uuid
  /// The "Suggest with AI" job in progress (status `suggesting`).
  suggestJobId    String?        @map("suggest_job_id") @db.Uuid
  /// { jobId, lines: [{ id, key, durationMs }] }: the voice files of the current script.
  voice           Json?
  voiceJobId      String?        @map("voice_job_id") @db.Uuid
  /// The latest finished render: { renderId, key, sizeBytes, webSizeBytes?, durationMs, renderedAt }.
  video           Json?
  renderId        String?        @map("render_id") @db.Uuid
  error           String?        @db.VarChar(300)
  createdBy       String         @map("created_by") @db.VarChar(255)
  updatedBy       String         @map("updated_by") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  renders         StudioRender[]

  @@index([siteId, updatedAt(sort: Desc)], map: "ix_studio_projects_site_updated")
  @@map("studio_projects")
}

/// One render request: history, the monthly quota, and the render report of the Remotion license.
/// Kept when the project is deleted (project_id set null): the count must not change.
model StudioRender {
  id          String         @id(map: "pk_studio_renders") @db.Uuid
  siteId      String         @map("site_id") @db.VarChar(50)
  projectId   String?        @map("project_id") @db.Uuid
  project     StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull, map: "fk_studio_renders_project")
  templateId  String         @map("template_id") @db.VarChar(40)
  status      String         @default("pending") @db.VarChar(20)
  sizeBytes   Int?           @map("size_bytes")
  durationMs  Int?           @map("duration_ms")
  renderMs    Int?           @map("render_ms")
  error       String?        @db.VarChar(300)
  createdBy   String         @map("created_by") @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(6)

  @@index([siteId, createdAt(sort: Desc)], map: "ix_studio_renders_site_created")
  @@index([projectId], map: "ix_studio_renders_project_id")
  @@map("studio_renders")
}

model InboxMessage {
  consumer    String   @db.VarChar(100)
  messageId   String   @map("message_id") @db.VarChar(200)
  subject     String   @db.VarChar(200)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId], map: "pk_inbox_messages")
  @@index([processedAt], map: "ix_inbox_messages_processed_at")
  @@map("inbox_messages")
}

model OutboxMessage {
  id          String    @id(map: "pk_outbox_messages") @db.Uuid
  subject     String    @db.VarChar(200)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)

  @@index([createdAt], map: "ix_outbox_messages_unpublished", where: raw("published_at IS NULL"))
  @@map("outbox_messages")
}

/// An article written by AI (ADR 0041): the admin's idea → a brief + outline (edited, confirmed) →
/// the article as blocks → its images (AI, the media library's quota) → a DRAFT article, then
/// machine translations into the site's other languages. Never published by itself.
model ArticleDraftJob {
  id          String    @id(map: "pk_article_draft_jobs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId      String    @map("site_id") @db.VarChar(50)
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Restrict, map: "fk_article_draft_jobs_site")
  categoryId  String    @map("category_id") @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "fk_article_draft_jobs_category")
  locale      String    @db.VarChar(10)
  /// { topic, idea, audience?, keyword?, length, images } (ArticleIdea in libs/common)
  idea        Json
  /// prompting | prompted | writing | illustrating | completed | failed (ArticleDraftStatus)
  status      String    @default("prompting") @db.VarChar(20)
  /// The brief, as written by AI then edited and confirmed by the admin
  prompt      String?
  /// The section headings (string[])
  outline     Json?
  /// The article as blocks (WrittenArticle), until it is built
  result      Json?
  /// The image generation jobs of the article, the cover first
  imageJobIds String[]  @map("image_job_ids") @db.Uuid
  articleId   String?   @map("article_id") @db.Uuid
  article     Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull, map: "fk_article_draft_jobs_article")
  /// Numbers of the article found in none of the facts (to check), and skipped steps
  warnings    Json?
  error       String?   @db.VarChar(50)
  detail      String?   @db.VarChar(300)
  provider    String?   @db.VarChar(30)
  model       String?   @db.VarChar(100)
  /// When the article was asked for: the monthly quota counts these
  writtenAt   DateTime? @map("written_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.VarChar(255)
  updatedBy   String    @map("updated_by") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([siteId, createdAt(sort: Desc)], map: "ix_article_draft_jobs_site_created")
  @@index([categoryId], map: "ix_article_draft_jobs_category_id")
  @@index([articleId], map: "ix_article_draft_jobs_article_id")
  @@map("article_draft_jobs")
}
