// Schema of the deployment-service database. Only this service connects to it.
// Connection settings for the CLI: ../prisma.config.ts. Runtime: src/prisma/prisma.service.ts.
//
//   npm run prisma:generate                       # regenerate the client after editing this file
//   npm run migration:dev -- --name <change_name> # create a migration from your schema change
//   npm run migration:run                         # apply pending migrations (prisma migrate deploy)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs" // the Nest apps compile to CommonJS
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Deployment {
  id          String       @id(map: "pk_deployments") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(100)
  version     String       @db.VarChar(50)
  environment String       @default("development") @db.VarChar(30)
  /// One of DEPLOYMENT_STATUSES (libs/common). Validated by the DTOs, stored as varchar.
  status      String       @default("pending") @db.VarChar(20)
  description String?
  /// Keycloak user id (`sub`) of the creator. Null for rows created before authentication
  /// existed: only an admin may change those.
  createdBy   String?      @map("created_by") @db.VarChar(255)
  /// Optimistic concurrency: +1 on every update. Sent to clients as the ETag; PATCH must
  /// send it back in If-Match and only succeeds if it is still current (else 412).
  /// Not to be confused with `version` (the deployed application's version).
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete: every query must filter on `deletedAt: null`.
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  /// Attachments (files table).
  files       StoredFile[]

  // Uniqueness is enforced by the DATABASE (race-safe), ignoring soft-deleted rows.
  @@unique([name, version], map: "uq_deployments_name_version", where: raw("deleted_at IS NULL"))
  @@map("deployments")
}

/// A file uploaded by a user. The BYTES live in object storage (S3 / Spaces / R2, see
/// libs/common/src/storage); this row is the source of truth for ownership, visibility and
/// lifecycle. Status: pending (upload URL issued) → uploaded (verified with HEAD) → deleting
/// (removed from the API, object being deleted) → deleted. CHECK constraints in the migration.
model StoredFile {
  id           String      @id(map: "pk_files") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What the file is for (FILE_PURPOSES in libs/common): allowed types, max size, visibility.
  purpose      String      @db.VarChar(50)
  /// public | private: which bucket. Derived from `purpose`, never chosen by the client.
  visibility   String      @db.VarChar(10)
  status       String      @default("pending") @db.VarChar(10)
  /// Object key, generated by the server ("<purpose>/<yyyy>/<mm>/<id>.<ext>"), never from user input.
  storageKey   String      @map("storage_key") @db.VarChar(512)
  /// Name shown to users and proposed on download. Sanitized; never used as a path.
  originalName String      @map("original_name") @db.VarChar(255)
  contentType  String      @map("content_type") @db.VarChar(127)
  /// Bytes. Declared before the upload, verified against the stored object on completion.
  size         Int
  /// Keycloak user id (`sub`) of the uploader.
  ownerId      String      @map("owner_id") @db.VarChar(255)
  /// Set when attached to a deployment; a file belongs to at most one deployment.
  deploymentId String?     @map("deployment_id") @db.Uuid
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull, map: "fk_files_deployment")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedAt   DateTime?   @map("uploaded_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  @@unique([storageKey], map: "uq_files_storage_key")
  @@index([deploymentId], map: "ix_files_deployment_id")
  @@index([ownerId, createdAt], map: "ix_files_owner_created")
  @@index([status, createdAt], map: "ix_files_status_created") // cleanup job
  @@map("files")
}

/// Transactional outbox (ADR 0007, libs/common/src/messaging/outbox.ts): messages written in the
/// SAME transaction as the data they describe, published to JetStream by OutboxRelay
/// (Nats-Msg-Id = id), marked published after the PubAck, deleted after 7 days.
model OutboxMessage {
  /// Message id end to end: Nats-Msg-Id on the wire, inbox key in every consumer.
  id          String    @id(map: "pk_outbox_messages") @db.Uuid
  subject     String    @db.VarChar(200)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)

  /// The relay's scan: unpublished rows, oldest first.
  @@index([createdAt], map: "ix_outbox_messages_unpublished", where: raw("published_at IS NULL"))
  @@map("outbox_messages")
}
