# Copy to .env for local development. Never commit .env.
NODE_ENV=development

# Shared
NATS_URL=nats://localhost:4222
# Logging: LOG_FORMAT=json (one JSON object per line, for Loki/Grafana; use it in k8s)
# or pretty (human-readable, local dev only, needs the pino-pretty dev dependency).
LOG_LEVEL=info
LOG_FORMAT=pretty
# Observability (ADR 0023). Metrics: always on, GET /metrics on each service's port.
# Tracing: off unless an OTLP endpoint is set (in the cluster: Grafana Alloy, set by k8s).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1

# deployment-service: REST API behind KrakenD (owns the "deployment" database;
# DB_* are also read by its prisma.config.ts). KrakenD calls it on this port.
DEPLOYMENT_PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=deployment

# Keycloak (k8s/base/keycloak). Tokens are verified locally with the realm's public keys (JWKS).
# AUTH_ISSUER must equal the token's `iss` (fixed by KC_HOSTNAME in k8s/overlays/dev/patches/keycloak.yaml).
AUTH_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
AUTH_JWKS_URL=http://auth.localtest.me:8000/realms/nest-microservice/protocol/openid-connect/certs
AUTH_AUDIENCE=deployments-api
AUTH_ROLES_CLIENT=deployments-api

# Uploaded files: object storage (libs/common/src/storage). Dev: SeaweedFS in the cluster
# (k8s/components/local-data/seaweedfs at the repo root), reached through `npm run k8s:forward` (repo root) on :8333.
# Browsers upload to these presigned URLs too, so the endpoint must be reachable from the browser.
# Production: STORAGE_PROVIDER=spaces | s3 | r2 (see k8s/overlays/prod/env/deployment-service.env).
STORAGE_PROVIDER=custom
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=dev-storage-key
STORAGE_SECRET_ACCESS_KEY=dev-storage-secret
STORAGE_PUBLIC_BUCKET=dev-public-files
STORAGE_PRIVATE_BUCKET=dev-private-files
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/dev-public-files

# notification-service
NOTIFICATION_HEALTH_PORT=3002

# notification-service: owns the "notification" database (its inbox; NOTIFICATION_DB_* are also
# read by apps/notification-service/prisma.config.ts). Same Postgres server in dev, own database.
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASSWORD=postgres
NOTIFICATION_DB_NAME=notification

# content-service (ADR 0026): REST on this port (KrakenD calls it), articles of the client sites.
CONTENT_PORT=3003
# Its own database "content" (CONTENT_DB_* are also read by apps/content-service/prisma.config.ts).
CONTENT_DB_HOST=localhost
CONTENT_DB_PORT=5432
CONTENT_DB_USER=postgres
CONTENT_DB_PASSWORD=postgres
CONTENT_DB_NAME=content
# Its own Keycloak resource server: tokens must have audience content-api and its client roles.
CONTENT_AUTH_AUDIENCE=content-api
# AI images each site may generate per calendar month (UTC), ADR 0037.
CONTENT_AI_IMAGES_PER_MONTH=50
# Finished videos each site may render per calendar month (UTC), ADR 0039 (video studio).
CONTENT_STUDIO_RENDERS_PER_MONTH=30
# Articles each site may have written by AI per calendar month (UTC), ADR 0041.
CONTENT_AI_ARTICLES_PER_MONTH=30

# --- ai-service (ADR 0036): the only service that calls AI providers ---
AI_HEALTH_PORT=3004
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_USER=postgres
AI_DB_PASSWORD=postgres
AI_DB_NAME=ai
# fake: no network, segments prefixed with [EN] (tests, offline dev) | gemini: needs GEMINI_API_KEY
AI_TRANSLATION_PROVIDER=fake
# Free key from Google AI Studio (https://aistudio.google.com/apikey). Never commit it.
# GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_TIMEOUT_MS=60000
# Images for the media library (ADR 0037): fake draws a placeholder | gemini (paid only, ~$0.034
# per 1K image). Written to the public bucket with the STORAGE_* settings above.
AI_IMAGE_PROVIDER=fake
AI_GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Video studio (ADR 0039): scripts (text model AI_GEMINI_MODEL) and text to speech.
# fake: no network (lines from the scene purposes, a quiet tone) | gemini: needs GEMINI_API_KEY
AI_SCRIPT_PROVIDER=fake
AI_SPEECH_PROVIDER=fake
AI_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
