{
  "realm": "site-travel",
  "displayName": "Gió Mùa Travel",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 86400,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "loginTheme": "customers",
  "emailTheme": "customers",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "smtpServer": {
    "host": "$(env:SMTP_HOST)",
    "port": "$(env:SMTP_PORT)",
    "from": "$(env:SMTP_FROM)",
    "fromDisplayName": "Gió Mùa Travel",
    "auth": "true",
    "starttls": "true",
    "user": "$(env:SMTP_USER)",
    "password": "$(env:SMTP_PASSWORD)"
  },
  "authenticationFlows": [
    {
      "alias": "first broker login never link",
      "description": "ADR 0050: never link at sign-in; a signed-in customer links Google from the account",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "$(env:GOOGLE_SIGN_IN)",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login never link",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)",
        "syncMode": "IMPORT"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {
        "max_auth_age": "300"
      }
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 90,
      "config": {
        "max_auth_age": "300"
      }
    },
    {
      "alias": "delete_credential",
      "name": "Delete Credential",
      "providerId": "delete_credential",
      "enabled": true,
      "defaultAction": false,
      "priority": 110,
      "config": {
        "max_auth_age": "300"
      }
    },
    {
      "alias": "idp_link",
      "name": "Linking Identity Provider",
      "providerId": "idp_link",
      "enabled": true,
      "defaultAction": false,
      "priority": 120,
      "config": {
        "max_auth_age": "300"
      }
    }
  ],
  "clients": [
    {
      "clientId": "travel-web",
      "name": "travel-web: its customers sign in (BFF, confidential; ADR 0049)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:TRAVEL_WEB_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "$(env:TRAVEL_URL)/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$(env:TRAVEL_URL)/*"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "unverified-cleanup",
      "name": "CronJob unverified-cleanup: deletes the accounts never activated within 24 h (ADR 0050)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:UNVERIFIED_CLEANUP_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-unverified-cleanup",
      "enabled": true,
      "serviceAccountClientId": "unverified-cleanup",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-users",
          "manage-users"
        ]
      }
    }
  ]
}
