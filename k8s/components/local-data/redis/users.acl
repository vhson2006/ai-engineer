user default off
user healthcheck on nopass -@all +ping
user web on >web-dev-redis-password resetkeys ~web:* resetchannels -@all +get +set +del +getdel +incr +expire +ping
user admin-web on >admin-web-dev-redis-password resetkeys ~admin-web:* resetchannels -@all +get +set +del +getdel +incr +expire +ping
user autoparts-web on >autoparts-web-dev-redis-password resetkeys ~autoparts-web:* resetchannels -@all +get +set +del +getdel +incr +expire +ping
user flowers-web on >flowers-web-dev-redis-password resetkeys ~flowers-web:* resetchannels -@all +get +set +del +getdel +incr +expire +ping
