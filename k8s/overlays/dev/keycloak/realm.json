    {
      "clientId": "web",
      "name": "Next.js frontend (BFF, confidential)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "web-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://www.localtest.me:8000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://www.localtest.me:8000",
        "http://localhost:3000"
      ],
      "attributes": {
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "36000",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://www.localtest.me:8000/*##http://localhost:3000/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-deployments-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "deployments-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-web",
