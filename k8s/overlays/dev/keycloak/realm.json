{
  "realm": "nest-microservice",
  "displayName": "nest-microservice",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "client": {
      "deployments-api": [
        {
          "name": "deployment:read",
          "description": "List and read deployments"
        },
        {
          "name": "deployment:write",
          "description": "Create deployments; update and delete your own"
        },
        {
          "name": "deployment:admin",
          "description": "Update and delete anyone's deployment"
        }
      ],
      "content-api": [
        {
          "name": "content:read",
          "description": "Read the content of your sites (drafts included)"
        },
        {
          "name": "content:write",
          "description": "Create and edit draft articles and categories of your sites"
        },
        {
          "name": "content:publish",
          "description": "Publish, schedule and unpublish; change articles that are not drafts"
        },
        {
          "name": "content:admin",
          "description": "Every site; create and change the sites themselves"
        }
      ],
      "admin-web": [
        {
          "name": "admin",
          "description": "May sign in to the admin site (admin-web): site admins and superadmins"
        },
        {
          "name": "superadmin",
          "description": "Every site + the system pages of admin-web; signs in with password + OTP (ADR 0030)"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "viewers",
      "clientRoles": {
        "deployments-api": [
          "deployment:read"
        ],
        "content-api": [
          "content:read"
        ]
      }
    },
    {
      "name": "developers",
      "clientRoles": {
        "deployments-api": [
          "deployment:read",
          "deployment:write"
        ],
        "content-api": [
          "content:read",
          "content:write"
        ]
      }
    },
    {
      "name": "admins",
      "clientRoles": {
        "deployments-api": [
          "deployment:read",
          "deployment:write",
          "deployment:admin"
        ],
        "admin-web": [
          "admin",
          "superadmin"
        ],
        "content-api": [
          "content:read",
          "content:write",
          "content:publish",
          "content:admin"
        ]
      }
    },
    {
      "name": "site-admins",
      "clientRoles": {
        "admin-web": [
          "admin"
        ],
        "content-api": [
          "content:read",
          "content:write",
          "content:publish"
        ]
      }
    },
    {
      "name": "sites",
      "subGroups": [
        {
          "name": "nails"
        },
        {
          "name": "wine"
        },
        {
          "name": "laundry"
        },
        {
          "name": "sushi"
