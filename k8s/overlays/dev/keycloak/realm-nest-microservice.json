{
  "realm": "nest-microservice",
  "displayName": "nest-microservice",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "client": {
      "deployments-api": [
        {
          "name": "deployment:read",
          "description": "List and read deployments"
        },
        {
          "name": "deployment:write",
          "description": "Create deployments; update and delete your own"
        },
        {
          "name": "deployment:admin",
          "description": "Update and delete anyone's deployment"
        }
      ],
      "content-api": [
        {
          "name": "content:read",
          "description": "Read the content of your sites (drafts included)"
        },
        {
          "name": "content:write",
          "description": "Create and edit draft articles and categories of your sites"
        },
        {
          "name": "content:publish",
          "description": "Publish, schedule and unpublish; change articles that are not drafts"
        },
        {
          "name": "content:admin",
          "description": "Every site; create and change the sites themselves"
        }
      ],
      "admin-web": [
        {
          "name": "admin",
          "description": "May sign in to the admin site (admin-web): site admins and superadmins"
        },
        {
          "name": "superadmin",
          "description": "Every site + the system pages of admin-web; signs in with password + OTP (ADR 0030)"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "viewers",
      "clientRoles": {
        "deployments-api": [
          "deployment:read"
        ],
        "content-api": [
          "content:read"
        ]
      }
    },
    {
      "name": "developers",
      "clientRoles": {
        "deployments-api": [
          "deployment:read",
          "deployment:write"
        ],
        "content-api": [
          "content:read",
          "content:write"
        ]
      }
    },
    {
      "name": "admins",
      "clientRoles": {
        "deployments-api": [
          "deployment:read",
          "deployment:write",
          "deployment:admin"
        ],
        "admin-web": [
          "admin",
          "superadmin"
        ],
        "content-api": [
          "content:read",
          "content:write",
          "content:publish",
          "content:admin"
        ]
      }
    },
    {
      "name": "site-admins",
      "clientRoles": {
        "admin-web": [
          "admin"
        ],
        "content-api": [
          "content:read",
          "content:write",
          "content:publish"
        ]
      }
    },
    {
      "name": "sites",
      "subGroups": [
        {
          "name": "nails"
        },
        {
          "name": "wine"
        },
        {
          "name": "laundry"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "deployments-api",
      "name": "Deployments API (resource server: holds the roles, used as token audience)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "content-api",
      "name": "Content API (resource server: holds the content roles, used as token audience)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "web",
      "name": "Next.js frontend (BFF, confidential)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "web-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://www.localtest.me:8000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://www.localtest.me:8000",
        "http://localhost:3000"
      ],
      "attributes": {
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "36000",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://www.localtest.me:8000/*##http://localhost:3000/*"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-deployments-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "deployments-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-web",
      "name": "Admin site (BFF, confidential): site admins (password) and superadmins (password + OTP)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "admin-web-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://admin.localtest.me:8000/*",
        "http://localhost:3100/*"
      ],
      "webOrigins": [
        "http://admin.localtest.me:8000",
        "http://localhost:3100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://admin.localtest.me:8000/*##http://localhost:3100/*",
        "client.session.idle.timeout": "28800",
        "client.session.max.lifespan": "604800"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-deployments-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "deployments-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-content-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "content-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
