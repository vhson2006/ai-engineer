# The public addresses of this environment: the ONE place they are written (ConfigMap
# "public-urls", read by Keycloak, KrakenD and the Job keycloak-config; components/public-urls
# copies them into the Gateway, the routes and the apps' settings). Dev: *.localtest.me → 127.0.0.1.
WILDCARD_HOST=*.localtest.me
WEB_HOST=www.localtest.me
ADMIN_HOST=admin.localtest.me
AUTH_HOST=auth.localtest.me
WEB_URL=http://www.localtest.me:8000
ADMIN_URL=http://admin.localtest.me:8000
AUTH_URL=http://auth.localtest.me:8000
KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
# Keycloak's admin console (port-forward only, never published; ADR 0004)
KEYCLOAK_CONSOLE_URL=http://localhost:8180
# Object storage seen from browsers (SeaweedFS through k8s:forward): for the apps running on this
# machine, whose .env.local hold the same values.
# PUBLIC_FILES_URL is also the only origin render-worker fetches a video's assets from (no SSRF).
PUBLIC_FILES_URL=http://localhost:8333/dev-public-files
WEB_STORAGE_ORIGINS=http://localhost:8333
ADMIN_STORAGE_ORIGINS=http://localhost:8333
SITES_STORAGE_ORIGINS=http://localhost:8333
