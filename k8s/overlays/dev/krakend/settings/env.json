{
  "auth": {
    "issuer": "http://auth.localtest.me:8000/realms/nest-microservice",
    "jwk_url": "http://keycloak.nest-microservice.svc.cluster.local:8080/realms/nest-microservice/protocol/openid-connect/certs",
    "jwk_over_plain_http": true,
    "audience": "deployments-api"
  },
  "services": {
    "deployment": "http://host.docker.internal:3001"
  },
  "log_level": "INFO",
  "ratelimit": {
    "read": {
      "max_rate": 200,
      "client_max_rate": 20,
      "every": "1s"
    },
    "write": {
      "max_rate": 50,
      "client_max_rate": 5,
      "every": "1s"
    }
  }
}
