{
  "auth": {
    "issuer": "https://auth.staging.localtest.me/realms/nest-microservice",
    "jwk_url": "http://keycloak.nest-staging.svc.cluster.local:8080/realms/nest-microservice/protocol/openid-connect/certs",
    "jwk_over_plain_http": true,
    "audience": "deployments-api"
  },
  "services": {
    "deployment": "http://deployment-service.nest-staging.svc.cluster.local:3001"
  },
  "ratelimit": {
    "read": { "max_rate": 200, "client_max_rate": 20, "every": "1s" },
    "write": { "max_rate": 50, "client_max_rate": 5, "every": "1s" }
  },
  "log_level": "INFO"
}
