# The public addresses of this environment: the ONE place they are written (ConfigMap
# "public-urls", read by Keycloak, KrakenD and the Job keycloak-config; components/public-urls
# copies them into the Gateway, the routes and the apps' settings).
WILDCARD_HOST=*.staging.localtest.me
WEB_HOST=www.staging.localtest.me
ADMIN_HOST=admin.staging.localtest.me
AUTH_HOST=auth.staging.localtest.me
WEB_URL=https://www.staging.localtest.me
ADMIN_URL=https://admin.staging.localtest.me
AUTH_URL=https://auth.staging.localtest.me
KEYCLOAK_ISSUER=https://auth.staging.localtest.me/realms/nest-microservice
# Keycloak's admin console (port-forward only, never published; ADR 0004)
KEYCLOAK_CONSOLE_URL=http://localhost:8181
# Object storage seen from browsers: the public files' base URL, and the origins the web apps'
# Content-Security-Policy allows (img-src, connect-src for presigned uploads).
# PUBLIC_FILES_URL is also the only origin render-worker fetches a video's assets from (no SSRF).
PUBLIC_FILES_URL=https://s3.staging.localtest.me/dev-public-files
WEB_STORAGE_ORIGINS=https://s3.staging.localtest.me
ADMIN_STORAGE_ORIGINS=https://s3.staging.localtest.me
SITES_STORAGE_ORIGINS=https://s3.staging.localtest.me
# The business sites this environment runs (k8s/sites/<id>): <ID>_HOST (route), <ID>_URL (APP_URL).
LAUNDRY_HOST=laundry.staging.localtest.me
LAUNDRY_URL=https://laundry.staging.localtest.me
NAILS_HOST=nails.staging.localtest.me
NAILS_URL=https://nails.staging.localtest.me
WINE_HOST=wine.staging.localtest.me
WINE_URL=https://wine.staging.localtest.me
# HSTS (Strict-Transport-Security on every public route): browsers then refuse plain HTTP AND any
# certificate error for max-age seconds, and remember it even if the header is removed. Ramp it up
# only while the certificates are healthy: 300 (go-live) -> 86400 (1 day) -> 604800 (1 week) ->
# 31536000 (1 year), a few weeks at each step. No includeSubDomains (every subdomain would then need
# HTTPS), never preload.
HSTS=max-age=300
