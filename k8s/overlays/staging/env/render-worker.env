NATS_URL=nats://nats.nest-staging.svc.cluster.local:4222
LOG_LEVEL=info
RENDER_WORKER_PORT=3005
RENDER_CONCURRENCY=1
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://s3.staging.localtest.me
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BUCKET=dev-public-files
STORAGE_PUBLIC_BASE_URL=https://s3.staging.localtest.me/dev-public-files
# The local CA (patches/apps-local-ca.yaml) signs s3.staging.localtest.me: Node trusts it through
# NODE_EXTRA_CA_CERTS, the headless browser doesn't, so it skips certificate errors HERE ONLY.
NODE_EXTRA_CA_CERTS=/etc/local-ca/ca.crt
RENDER_IGNORE_CERT_ERRORS=true
