# Public addresses (AUTH_ISSUER, STORAGE_PUBLIC_BASE_URL): urls.env of this overlay (components/public-urls).
NATS_URL=nats://nats.nest-staging.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
DEPLOYMENT_PORT=3001
AUTH_JWKS_URL=http://keycloak.nest-staging.svc.cluster.local:8080/realms/nest-microservice/protocol/openid-connect/certs
AUTH_AUDIENCE=deployments-api
AUTH_ROLES_CLIENT=deployments-api
# Object storage through the Gateway, the URL browsers use too (presigned URLs are signed for it).
STORAGE_PROVIDER=custom
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://s3.staging.localtest.me
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BUCKET=dev-public-files
STORAGE_PRIVATE_BUCKET=dev-private-files
# The local CA (mounted by patches/apps-local-ca.yaml): https://s3.staging.localtest.me is signed by it.
NODE_EXTRA_CA_CERTS=/etc/local-ca/ca.crt
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
