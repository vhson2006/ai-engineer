NATS_URL=nats://nats.nest-staging.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
CONTENT_PORT=3003
AUTH_ISSUER=https://auth.staging.localtest.me/realms/nest-microservice
AUTH_JWKS_URL=http://keycloak.nest-staging.svc.cluster.local:8080/realms/nest-microservice/protocol/openid-connect/certs
# Its own resource server (src/env.ts sets AUTH_AUDIENCE / AUTH_ROLES_CLIENT from it).
CONTENT_AUTH_AUDIENCE=content-api
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
