APP_URL=https://www.staging.localtest.me
API_URL=http://krakend.nest-staging.svc.cluster.local:8080
KEYCLOAK_ISSUER=https://auth.staging.localtest.me/realms/nest-microservice
KEYCLOAK_CLIENT_ID=web
STORAGE_ORIGINS=https://s3.staging.localtest.me
# The local CA (mounted by patches/apps-local-ca.yaml): Keycloak's https issuer is signed by it.
NODE_EXTRA_CA_CERTS=/etc/local-ca/ca.crt
