NATS_URL=nats://nats.nest-staging.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
AI_HEALTH_PORT=3004
# The fake provider: no account, no network (prefixes the text with [EN]). Use gemini + Secret
# "ai-providers" (GEMINI_API_KEY) to translate for real (ADR 0036).
AI_TRANSLATION_PROVIDER=fake
AI_GEMINI_MODEL=gemini-3.8-flash
# Images (ADR 0037): the fake provider draws a placeholder; gemini is paid only (no free tier).
AI_IMAGE_PROVIDER=fake
AI_GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Object storage: the generated images go to the media library's public bucket (as content-service).
STORAGE_PROVIDER=custom
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://s3.staging.localtest.me
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BUCKET=dev-public-files
STORAGE_PRIVATE_BUCKET=dev-private-files
STORAGE_PUBLIC_BASE_URL=https://s3.staging.localtest.me/dev-public-files
# The local CA (mounted by patches/apps-local-ca.yaml): https://s3.staging.localtest.me is signed by it.
NODE_EXTRA_CA_CERTS=/etc/local-ca/ca.crt
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
