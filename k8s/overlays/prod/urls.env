# The public addresses of this environment: the ONE place they are written (ConfigMap
# "public-urls", read by Keycloak, KrakenD and the Job keycloak-config; components/public-urls
# copies them into the Gateway, the routes and the apps' settings). Go-live: replace example.com
# here (and the bucket names), set the repository variable PROD_DOMAIN, and that's all.
WILDCARD_HOST=*.example.com
WEB_HOST=www.example.com
ADMIN_HOST=admin.example.com
AUTH_HOST=auth.example.com
WEB_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
AUTH_URL=https://auth.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/nest-microservice
# Keycloak's admin console (port-forward only, never published; ADR 0004)
KEYCLOAK_CONSOLE_URL=http://localhost:8180
# Object storage seen from browsers: the public files through the CDN, and the origins the web
# apps' Content-Security-Policy allows (the buckets for presigned uploads, the CDN for images).
# PUBLIC_FILES_URL is also the only origin render-worker fetches a video's assets from (no SSRF).
PUBLIC_FILES_URL=https://cdn.example.com
WEB_STORAGE_ORIGINS=https://example-public-files.sgp1.digitaloceanspaces.com https://example-private-files.sgp1.digitaloceanspaces.com https://cdn.example.com
ADMIN_STORAGE_ORIGINS=https://example-public-files.sgp1.digitaloceanspaces.com https://cdn.example.com
SITES_STORAGE_ORIGINS=https://cdn.example.com
# The business sites this environment runs (k8s/sites/<id>): <ID>_HOST (route), <ID>_URL (APP_URL,
# Keycloak redirects). A subdomain of the main domain for now (the wildcard certificate covers it);
# a site's own domain later: k8s/README.md, "A business site on its own domain".
AUTOPARTS_HOST=autoparts.example.com
AUTOPARTS_URL=https://autoparts.example.com
FLOWERS_HOST=flowers.example.com
FLOWERS_URL=https://flowers.example.com
HOTEL_HOST=hotel.example.com
HOTEL_URL=https://hotel.example.com
LAUNDRY_HOST=laundry.example.com
LAUNDRY_URL=https://laundry.example.com
NAILS_HOST=nails.example.com
NAILS_URL=https://nails.example.com
SPA_HOST=spa.example.com
SPA_URL=https://spa.example.com
SUSHI_HOST=sushi.example.com
SUSHI_URL=https://sushi.example.com
TRAVEL_HOST=travel.example.com
TRAVEL_URL=https://travel.example.com
WINE_HOST=wine.example.com
WINE_URL=https://wine.example.com
# HSTS (Strict-Transport-Security on every public route): browsers then refuse plain HTTP AND any
# certificate error for max-age seconds, and remember it even if the header is removed. Ramp it up
# only while the certificates are healthy: 300 (go-live) -> 86400 (1 day) -> 604800 (1 week) ->
# 31536000 (1 year), a few weeks at each step. No includeSubDomains (every subdomain would then need
# HTTPS), never preload.
HSTS=max-age=300
