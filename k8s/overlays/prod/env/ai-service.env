# Public addresses (STORAGE_PUBLIC_BASE_URL): urls.env of this overlay (components/public-urls).
NATS_URL=nats://nats.nest-microservice.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
AI_HEALTH_PORT=3004
# Gemini (ADR 0036): GEMINI_API_KEY from the ExternalSecret "ai-providers". The free tier may use
# the content to improve Google's products: only public content (articles) goes there.
AI_TRANSLATION_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-3.8-flash
# Images (ADR 0037): paid tier only (~$0.034 per 1K image); quota per site in content-service.
AI_IMAGE_PROVIDER=gemini
AI_GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Video studio (ADR 0039): scripts with AI_GEMINI_MODEL, voices with Gemini TTS.
AI_SCRIPT_PROVIDER=gemini
AI_SPEECH_PROVIDER=gemini
AI_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Object storage: generated images go to the media library's public bucket (as content-service).
STORAGE_PROVIDER=spaces
STORAGE_REGION=sgp1
STORAGE_PUBLIC_BUCKET=example-public-files
STORAGE_PRIVATE_BUCKET=example-private-files
STORAGE_PUBLIC_OBJECT_ACL=public-read
PGSSLMODE=verify-full
NODE_EXTRA_CA_CERTS=/etc/db-ca/ca.crt
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=0.25
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
