NATS_URL=nats://nats.nest-microservice.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
DEPLOYMENT_PORT=3001
AUTH_ISSUER=https://auth.example.com/realms/nest-microservice
AUTH_JWKS_URL=http://keycloak.nest-microservice.svc.cluster.local:8080/realms/nest-microservice/protocol/openid-connect/certs
AUTH_AUDIENCE=deployments-api
AUTH_ROLES_CLIENT=deployments-api
PGSSLMODE=verify-full
NODE_EXTRA_CA_CERTS=/etc/db-ca/ca.crt
STORAGE_PROVIDER=spaces
STORAGE_REGION=sgp1
STORAGE_PUBLIC_BUCKET=example-public-files
STORAGE_PRIVATE_BUCKET=example-private-files
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
STORAGE_PUBLIC_OBJECT_ACL=public-read
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=0.25
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
