# Public addresses (STORAGE_PUBLIC_BASE_URL): urls.env of this overlay (components/public-urls).
NATS_URL=nats://nats.nest-microservice.svc.cluster.local:4222
LOG_LEVEL=info
RENDER_WORKER_PORT=3005
# One browser tab per render: the pod has 1 CPU (shares the nodes with the site, ADR 0039).
RENDER_CONCURRENCY=1
RENDER_ACK_WAIT_MS=300000
# The public bucket the clips go to (studio/<site>/<project>/video/), as content-service.
STORAGE_REGION=sgp1
STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BUCKET=example-public-files
STORAGE_PUBLIC_OBJECT_ACL=public-read
