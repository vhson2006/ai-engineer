# Public addresses (APP_URL, KEYCLOAK_ISSUER, STORAGE_ORIGINS): urls.env of this overlay (components/public-urls).
API_URL=http://krakend.nest-microservice.svc.cluster.local:8080
KEYCLOAK_CLIENT_ID=admin-web
# Only Keycloak users with this client role may sign in (ADR 0019).
KEYCLOAK_REQUIRED_ROLE=admin-web:admin
# Its own key space AND its own Valkey user restricted to it (k8s/README.md#production).
REDIS_KEY_PREFIX=admin-web:
