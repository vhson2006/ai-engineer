NATS_URL=nats://nats.nest-microservice.svc.cluster.local:4222
LOG_LEVEL=info
LOG_FORMAT=json
NOTIFICATION_HEALTH_PORT=3002
# Traces → Alloy in this namespace → Grafana Cloud (ADR 0023). Metrics: Alloy scrapes /metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER_ARG=0.25
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
