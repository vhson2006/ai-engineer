    },
    {
      "@comment": "Create a draft: 201 + Location pass through unchanged.",
      "endpoint": "/api/content/sites/{siteId}/articles",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization", "X-Request-Id"],
      "extra_config": {{ template "endpoint.tmpl" (dict "env" .env "audience" "content-api" "roles" (list "content:write" "content:publish" "content:admin") "limit" "write") }},
      "backend": [{ "host": [{{ marshal .env.services.content }}], "url_pattern": "/api/content/sites/{siteId}/articles", "encoding": "no-op" }]
    },
    {
      "@comment": "Drafts: content:write; scheduled or live articles: content:publish (checked by the service).",
      "endpoint": "/api/content/sites/{siteId}/articles/{id}",
      "method": "PATCH",
      "output_encoding": "no-op",
