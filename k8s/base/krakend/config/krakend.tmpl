      "backend": [{ "host": [{{ marshal .env.services.deployment }}], "url_pattern": "/api/files/{id}", "encoding": "no-op" }]
    },
    {
      "@comment": "Files: short-lived link to the bytes (JSON). Not a redirect: KrakenD CE would follow it and stream the file itself.",
