      "method": "DELETE",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "X-Request-Id"],
      "extra_config": {{ template "endpoint.tmpl" (dict "env" .env "roles" (list "deployment:write" "deployment:admin") "limit" "write") }},
      "backend": [{ "host": [{{ marshal .env.services.deployment }}], "url_pattern": "/api/files/{id}", "encoding": "no-op" }]
    },
    {
