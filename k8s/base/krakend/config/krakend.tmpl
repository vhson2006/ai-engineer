      "method": "DELETE",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "X-Request-Id"],
      "extra_config": {{ template "endpoint.tmpl" (dict "env" .env "audience" "content-api" "roles" (list "content:write" "content:admin") "limit" "write") }},
      "backend": [{ "host": [{{ marshal .env.services.content }}], "url_pattern": "/api/content/sites/{siteId}/categories/{id}", "encoding": "no-op" }]
    },
    {
