      "input_headers": ["Authorization", "X-Request-Id"],
      "extra_config": {{ template "endpoint.tmpl" (dict "env" .env "roles" (list "deployment:read") "limit" "read") }},
      "backend": [{ "host": [{{ marshal .env.services.deployment }}], "url_pattern": "/api/files", "encoding": "no-op" }]
    },
    {
      "@comment": "Files: metadata + a fresh URL (public CDN or presigned). Visibility rules in the service.",
