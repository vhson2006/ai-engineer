# Your own values for the LOCAL Keycloak (dev and local staging), e.g. to try "Sign in with Google"
# (ADR 0050). Copy to k8s/.keycloak-local.env (git-ignored) and run `npm run k8s:up` or
# `npm run staging:up`: they turn it into Secret "keycloak-local", which the Job keycloak-config
# reads last, so these keys override the overlay's Secret keycloak-customer-auth. Delete the file
# (and run k8s:up again) to go back. PROD: the secret manager entry
# nest-microservice-prod-keycloak-customer-auth (k8s/overlays/prod/secrets/external-secrets.yaml).
#
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web
# application). Authorized redirect URIs, one per site realm, e.g. for dev:
#   http://auth.localtest.me:8000/realms/site-nails/broker/google/endpoint
#   (staging: https://auth.staging.localtest.me/realms/site-<id>/broker/google/endpoint)
GOOGLE_SIGN_IN=true
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace_me

# Real e-mail instead of Mailpit (optional): a Gmail account with 2-step verification and an app
# password (myaccount.google.com → Security → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=your.address@gmail.com
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
