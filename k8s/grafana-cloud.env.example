# Grafana Cloud credentials for Alloy (ADR 0023). LOCAL STAGING: copy to k8s/.grafana-cloud.env
# (git-ignored) and run `npm run staging:up`; without that file staging runs with Alloy scaled to 0.
# PROD: the same keys in the secret manager entry nest-microservice-prod-grafana-cloud.
#
# Where to find the values: grafana.com → My Account → your stack:
#   Prometheus → "Details": Remote Write Endpoint + Username (Instance ID)
#   Loki       → "Details": URL + "/loki/api/v1/push", Username (User)
#   OpenTelemetry → "Configure": OTLP Endpoint + Instance ID
# Token: Access Policies → create a policy with scopes metrics:write, logs:write, traces:write
# (nothing else), then "Add token". Write-only: it can't read your data.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=1234567
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=1234567
GRAFANA_CLOUD_OTLP_URL=https://otlp-gateway-prod-REGION.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USER=1234567
GRAFANA_CLOUD_TOKEN=glc_replace_me
