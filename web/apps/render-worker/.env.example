# render-worker (ADR 0039). Copy to .env.local for local development. Never commit .env.local.
# 127.0.0.1, not localhost: the port-forward listens on IPv4 only and Node tries ::1 first.
NATS_URL=nats://127.0.0.1:4222
LOG_LEVEL=info
RENDER_WORKER_PORT=3005
# Remotion's local bundle server (headless browser only); fixed so it never takes a web app's port (3000–4000).
REMOTION_PORT=3006
# Browser tabs per render: about half the CPU cores.
RENDER_CONCURRENCY=2
# The public bucket the clips go to (SeaweedFS in dev, as nest-microservice/.env).
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=dev-storage-key
STORAGE_SECRET_ACCESS_KEY=dev-storage-secret
STORAGE_PUBLIC_BUCKET=dev-public-files
# Every image, face, voice and logo of a video must come from here (the CDN).
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/dev-public-files
