# Copy to .env.local for local development. Never commit .env.local.
# Read on the server only (no NEXT_PUBLIC_ prefix).

# Public URL of this site (Content-Security-Policy, HMR websocket in dev).
APP_URL=http://localhost:3400

# Object storage / CDN origins of the article images (media library, ADR 0034) and later the
# product photos (img-src).
# Space-separated origins.
STORAGE_ORIGINS=http://localhost:8333

# Articles from content-service (ADR 0032): this server's OWN Keycloak client (service account,
# client credentials; no visitor signs in) and the private API (KrakenD). Server only.
API_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
KEYCLOAK_CLIENT_ID=laundry-web
# DEV ONLY value (realm overlays/dev). Staging/prod: from a Secret, never in a file.
KEYCLOAK_CLIENT_SECRET=laundry-web-dev-secret
