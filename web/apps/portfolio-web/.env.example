# Copy to .env.local for local development. Never commit .env.local.
# All variables are read on the server only (no NEXT_PUBLIC_ prefix): nothing here reaches the browser.

# Public URL of this site. Keycloak redirects back to ${APP_URL}/auth/callback,
# which must match the "web" client's Valid Redirect URIs (http://www.localtest.me:8000/*, http://localhost:3000/*).
APP_URL=http://www.localtest.me:8000

# The API: KrakenD. Private (no public route): dev through `npm run k8s:forward` at the repo root;
# prod: the in-cluster Service. Only this server calls it, never the browser.
API_URL=http://localhost:8080

# Server-side sessions (the Keycloak tokens never go to the browser), as the Redis ACL user "web"
# (k8s/components/local-data/redis/users.acl at the repo root): only keys web:*, only GET/SET/DEL/GETDEL/INCR/EXPIRE/PING.
REDIS_URL=redis://web:web-dev-redis-password@localhost:6379
# 32 random bytes (base64url) used to encrypt the sessions stored in Redis. Changing it signs
# everybody out. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64url

# Keycloak realm and the confidential "web" client (k8s/keycloak/realm-nest-microservice.json).
KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_CLIENT_SECRET=web-dev-secret

# Object storage origins the browser talks to (presigned uploads, images, inline files): allowed in
# the Content-Security-Policy (connect-src, img-src, media-src). Space-separated origins.
STORAGE_ORIGINS=http://localhost:8333
