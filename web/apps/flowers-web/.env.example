# Copy to .env.local for local development. Never commit .env.local.
# Read on the server only (no NEXT_PUBLIC_ prefix).

# Public URL of this site (Content-Security-Policy, HMR websocket in dev).
APP_URL=http://localhost:3700
# Public origin for search engines and link previews (canonical, hreflang, sitemap, Open Graph),
# baked into the build. Production: the real https:// domain. Defaults to APP_URL.
# SITE_URL=https://www.example.com

# Object storage / CDN origins of the article images (media library, ADR 0034) (img-src).
# Space-separated origins.
STORAGE_ORIGINS=http://localhost:8333

# The private API (KrakenD): articles from content-service (ADR 0032). Server only.
API_URL=http://localhost:8080
# This server's OWN Keycloak client, the same id and secret in two realms:
#   - API_KEYCLOAK_ISSUER (nest-microservice): its service account reads the site's articles;
#   - KEYCLOAK_ISSUER (site-flowers): its customers sign in (ADR 0049; in dev: bob or carol).
API_KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/site-flowers
KEYCLOAK_CLIENT_ID=flowers-web
# DEV ONLY value (realm overlays/dev). Staging/prod: from a Secret, never in a file.
KEYCLOAK_CLIENT_SECRET=flowers-web-dev-secret

# Customers' sessions (ADR 0049): Redis as this site's own ACL user (keys flowers-web:* only; users in
# k8s/components/local-data/redis/users.acl) and the key that encrypts them.
REDIS_URL=redis://flowers-web:flowers-web-dev-redis-password@localhost:6379
REDIS_KEY_PREFIX=flowers-web:
# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64url
