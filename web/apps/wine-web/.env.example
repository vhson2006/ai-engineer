# Copy to .env.local for local development. Never commit .env.local.
# Read on the server only (no NEXT_PUBLIC_ prefix).

# Public URL of this site (Content-Security-Policy, HMR websocket in dev).
APP_URL=http://localhost:3300

# Object storage / CDN origins for the product photos once they come from the API (img-src).
# Space-separated origins. Empty while the site uses the hard-coded demo content.
STORAGE_ORIGINS=
