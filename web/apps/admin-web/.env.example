# admin-web, local development (npm run dev → http://admin.localtest.me:8000, Next on :3100).
# Copy to .env.local. Every value here is DEV ONLY.

# Public URL of this app (behind the edge Gateway): redirects, Keycloak redirect_uri, CSRF origin.
APP_URL=http://admin.localtest.me:8000
# KrakenD (private; npm run k8s:forward at the repo root).
API_URL=http://localhost:8080
# Its OWN Redis ACL user, restricted to keys admin-web:* (k8s/components/local-data/redis/users.acl).
REDIS_URL=redis://admin-web:admin-web-dev-redis-password@localhost:6379
REDIS_KEY_PREFIX=admin-web:
# 32 random bytes, base64url, different from portfolio-web's:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64url
# Keycloak client "admin-web": its browser flow requires password + OTP (npm run keycloak:admin-otp).
KEYCLOAK_ISSUER=http://auth.localtest.me:8000/realms/nest-microservice
KEYCLOAK_CLIENT_ID=admin-web
KEYCLOAK_CLIENT_SECRET=admin-web-dev-secret
# Only users with this client role may sign in (group "admins" in the dev realm: alice).
KEYCLOAK_REQUIRED_ROLE=admin-web:admin

# Object storage the browser talks to (media library: presigned uploads, image previews, ADR 0034):
# allowed in the CSP (connect-src, img-src). The storage must allow this app's origin in its CORS.
STORAGE_ORIGINS=http://localhost:8333
